@model ChangePassport

<div class="container-sm col-md-6 d-flex flex-column align-items-center">
    <form method="post" asp-area="Admin" asp-controller="User" asp-action="ChangePassport">
        <h3 class="mb-2 text-center">Change Passport</h3>

        <div class="validation text-danger" asp-validation-summary="All"></div>

        <input type="hidden" name="userName" value="@Model?.UserName" />

        <div class="form-group mb-2">
            <label asp-for="Password">Name</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="ConfirmPassword">Cost</label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>


        <div class="mb-2">
            <button type="submit" class="btn btn-secondary mt-3">Change Passport</button>
        </div>
    </form>
</div>
