@model List<UserAccount>
@{
    ViewData["Title"] = "User list";
}
<div class="container">
    <!-- Заголовок -->
    <div class="row">
        <div class="col-md-12 text-center">
            <h3>@ViewData["Title"]</h3>
        </div>
    </div>
    <div class="row">
        @await Html.PartialAsync("AdminLeftPanel")
        <div class="col-10">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Name</th>
                        <th>Password</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>@(i+1)</td>
                            <td>@Model[i].Name</td>
                            <td>@Model[i].Password</td>
                            <td>
                                <a asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="Details"
                                   asp-route-name="@Model[i].Name" class="btn btn-secondary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>